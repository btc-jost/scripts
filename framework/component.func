# Entry point sourced by the reusable component scripts in component/. It pulls
# in everything a component needs: the core utilities, the installer engine, the
# question wizard and the shared component tools. Composites use composite.func
# instead (which additionally provides include_component).

[[ -n "${_COMPONENT_FUNC_LOADED:-}" ]] && return
_COMPONENT_FUNC_LOADED=1

FUNC_BASE_URL="${FUNC_BASE_URL:-https://raw.githubusercontent.com/btc-jost/scripts/main}"
# shellcheck disable=SC1090
[[ -n "${_CORE_FUNC_LOADED:-}" ]] || source <(wget -qO- "${FUNC_BASE_URL}/framework/core.func")
# shellcheck disable=SC1090
[[ -n "${_ENGINE_FUNC_LOADED:-}" ]] || source <(wget -qO- "${FUNC_BASE_URL}/framework/engine.func")
# shellcheck disable=SC1090
[[ -n "${_PROMPT_FUNC_LOADED:-}" ]] || source <(wget -qO- "${FUNC_BASE_URL}/framework/prompt.func")
# shellcheck disable=SC1090
[[ -n "${_COMPONENT_TOOLS_FUNC_LOADED:-}" ]] || source <(wget -qO- "${FUNC_BASE_URL}/framework/component-tools.func")
