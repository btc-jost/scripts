[[ -n "${_PROMPT_FUNC_LOADED:-}" ]] && return
_PROMPT_FUNC_LOADED=1

FUNC_BASE_URL="${FUNC_BASE_URL:-https://raw.githubusercontent.com/btc-jost/scripts/main}"
# shellcheck disable=SC1090
[[ -n "${_CORE_FUNC_LOADED:-}" ]] || source <(wget -qO- "${FUNC_BASE_URL}/framework/core.func")

# ==============================================================================
# Question registry
# ==============================================================================
#
# A component declares the input it needs; the core runs the wizard and stores
# each answer into a global variable named by the question KEY. The component
# never writes whiptail calls - it reads $KEY later (e.g. in post_install).
#
# register_question <KEY> <type> <prompt> [opt]...
#   type:
#     input       text entry           -> $KEY (string)
#     yesno       yes/no question       -> $KEY ("yes"|"no")
#     menu        pick one of N tags    -> $KEY (chosen tag)
#     input_list  repeat until empty    -> $KEY (bash array)
#   opt (each a separate argument so values may contain spaces):
#     default=<v>                 default value (or default tag for menu)
#     validate=alnum|num|nonempty|regex:<re>
#     when=<KEY>=<value>          only ask when a previous answer matches
#     <tag>=<label>               a menu option (menu type only)
#
# Example:
#   register_question CUSTOMER input "Set customer name" validate=alnum
#   register_question SOURCE menu "Choose NTP source" default=swiss \
#     "swiss=Swiss NTP pool" "custom=User defined"
#   register_question CUSTOM input_list "Enter NTP server (empty to finish)" \
#     when=SOURCE=custom
# ------------------------------------------------------------------------------

_Q_KEYS=()
_Q_TYPES=()
_Q_PROMPTS=()
_Q_OPTS=() # remaining args, joined with the unit-separator (\037)

register_question() {
  local key="$1" type="$2" prompt="$3"
  shift 3
  _Q_KEYS+=("$key")
  _Q_TYPES+=("$type")
  _Q_PROMPTS+=("$prompt")
  local IFS=$'\037'
  _Q_OPTS+=("$*")
}

# ------------------------------------------------------------------------------
# Internal: split a stored opts blob (index $1) into the _OPT_* / _OPT_MENU vars.
# ------------------------------------------------------------------------------
_q_parse_opts() {
  local idx="$1" tok
  _OPT_DEFAULT=""
  _OPT_VALIDATE=""
  _OPT_WHEN=""
  _OPT_MENU=()
  local IFS=$'\037'
  for tok in ${_Q_OPTS[$idx]}; do
    case "$tok" in
      default=*) _OPT_DEFAULT="${tok#default=}" ;;
      validate=*) _OPT_VALIDATE="${tok#validate=}" ;;
      when=*) _OPT_WHEN="${tok#when=}" ;;
      *=*) _OPT_MENU+=("$tok") ;;
    esac
  done
}

# Internal: is question $1 applicable given previously collected answers?
_q_condition_met() {
  _q_parse_opts "$1"
  [[ -z "$_OPT_WHEN" ]] && return 0
  local cond_key="${_OPT_WHEN%%=*}" cond_val="${_OPT_WHEN#*=}"
  [[ "${!cond_key:-}" == "$cond_val" ]]
}

# Internal: validate $2 against rule $1. Empty rule always passes.
_q_validate() {
  local rule="$1" value="$2"
  case "$rule" in
    "") return 0 ;;
    alnum) [[ "$value" =~ ^[[:alnum:]]+$ ]] ;;
    num) [[ "$value" =~ ^[0-9]+$ ]] ;;
    nonempty) [[ -n "$value" ]] ;;
    regex:*) [[ "$value" =~ ${rule#regex:} ]] ;;
    *) return 0 ;;
  esac
}

# Internal: store a scalar answer into the global named by $1.
_q_store() {
  printf -v "$1" '%s' "$2"
}

# Internal: store an array answer into the global array named by $1.
_q_store_list() {
  local name="$1"
  shift
  declare -ga "$name"
  local -n _ref="$name"
  _ref=("$@")
  unset -n _ref
}

# Internal: apply the declared default without prompting (unattended path).
_q_apply_default() {
  local idx="$1"
  local key="${_Q_KEYS[$idx]}" type="${_Q_TYPES[$idx]}"
  _q_parse_opts "$idx"
  case "$type" in
    input_list)
      if [[ -n "$_OPT_DEFAULT" ]]; then
        local IFS=','
        read -ra _vals <<<"$_OPT_DEFAULT"
        _q_store_list "$key" "${_vals[@]}"
      else
        _q_store_list "$key"
      fi
      ;;
    *) _q_store "$key" "$_OPT_DEFAULT" ;;
  esac
}

# Internal: clear an answer (used when a conditional question is skipped).
_q_clear_answer() {
  local idx="$1"
  local key="${_Q_KEYS[$idx]}"
  if [[ "${_Q_TYPES[$idx]}" == "input_list" ]]; then
    _q_store_list "$key"
  else
    _q_store "$key" ""
  fi
}

# ------------------------------------------------------------------------------
# Internal: ask a single question with whiptail. Returns 0 on Next, 1 on Back.
# $1 idx  $2 step  $3 total
# ------------------------------------------------------------------------------
_q_ask() {
  local idx="$1" step="$2" total="$3"
  local key="${_Q_KEYS[$idx]}"
  local type="${_Q_TYPES[$idx]}" prompt="${_Q_PROMPTS[$idx]}"
  local backtitle="${TITLE} [Step ${step}/${total}]"
  _q_parse_opts "$idx"
  local back_button="Back"
  [[ "$step" == "1" ]] && back_button="Exit"

  case "$type" in
    input)
      local value
      while true; do
        value=$(whiptail --backtitle "$backtitle" --title "$key" \
          --ok-button "Next" --cancel-button "$back_button" \
          --inputbox "\n${prompt}" 10 60 "${!key:-$_OPT_DEFAULT}" \
          3>&1 1>&2 2>&3) || return 1
        if _q_validate "$_OPT_VALIDATE" "$value"; then
          _q_store "$key" "$value"
          return 0
        fi
        whiptail --backtitle "$backtitle" --title "Invalid value" \
          --msgbox "The value does not satisfy: ${_OPT_VALIDATE}" 8 60
      done
      ;;
    yesno)
      if whiptail --backtitle "$backtitle" --title "$key" \
        --yes-button "Yes" --no-button "No" \
        --yesno "\n${prompt}" 10 60 3>&1 1>&2 2>&3; then
        _q_store "$key" "yes"
      else
        _q_store "$key" "no"
      fi
      return 0
      ;;
    menu)
      local menu_args=() pair tag label
      for pair in "${_OPT_MENU[@]}"; do
        tag="${pair%%=*}"
        label="${pair#*=}"
        menu_args+=("$tag" "$label")
      done
      local value
      value=$(whiptail --backtitle "$backtitle" --title "$key" \
        --ok-button "Next" --cancel-button "$back_button" \
        --default-item "${!key:-$_OPT_DEFAULT}" \
        --menu "\n${prompt}" 16 60 "${#_OPT_MENU[@]}" \
        "${menu_args[@]}" 3>&1 1>&2 2>&3) || return 1
      _q_store "$key" "$value"
      return 0
      ;;
    input_list)
      local entries=() entry
      while true; do
        entry=$(whiptail --backtitle "$backtitle" --title "$key" \
          --ok-button "Add" --cancel-button "Done" \
          --inputbox "\n${prompt}" 10 60 \
          3>&1 1>&2 2>&3) || break
        [[ -z "$entry" ]] && break
        entries+=("$entry")
      done
      _q_store_list "$key" "${entries[@]}"
      return 0
      ;;
    *)
      msg_error "Unknown question type '${type}' for '${key}'"
      return 0
      ;;
  esac
}

# ------------------------------------------------------------------------------
# run_questions() - built-in configure step. Drives all declared questions as a
# multi-step wizard (Next/Back/Exit) with conditional skipping. In unattended /
# non-TTY mode it fills declared defaults without prompting.
# ------------------------------------------------------------------------------
run_questions() {
  local n=${#_Q_KEYS[@]}
  ((n == 0)) && return 0

  if is_unattended || ! command -v whiptail >/dev/null 2>&1; then
    local i
    for ((i = 0; i < n; i++)); do _q_apply_default "$i"; done
    return 0
  fi

  tput smcup 2>/dev/null || true
  local i=0 dir=1
  while ((i >= 0 && i < n)); do
    if ! _q_condition_met "$i"; then
      _q_clear_answer "$i"
      i=$((i + dir))
      ((i < 0)) && i=0
      continue
    fi
    if _q_ask "$i" "$((i + 1))" "$n"; then
      dir=1
      i=$((i + 1))
    else
      if ((i == 0)); then
        tput rmcup 2>/dev/null || true
        exit_script
      fi
      dir=-1
      i=$((i - 1))
    fi
  done
  tput rmcup 2>/dev/null || true
}
